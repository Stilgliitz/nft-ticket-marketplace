<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dialogOwnerIdLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@android:color/white">

    <TextView
        android:id="@+id/txtOwnerIdTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚠ Important - OwnerID"
        android:textStyle="bold"
        android:textSize="20sp"
        android:textColor="@android:color/black"/>

    <TextView
        android:id="@+id/txtOwnerIdMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="12dp"
        android:text="This is your Owner ID. It is unique to your account.\n\nPlease write this down and store it somewhere safe. You will need it for ticket verification, resale, and ownership transfers. It cannot be retrieved again without necessary precautions."
        android:textSize="16sp"
        android:textColor="@android:color/black"/>

    <TextView
        android:id="@+id/txtActualOwnerId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="OwnerID: OWNER1234"
        android:paddingTop="18dp"
        android:paddingBottom="18dp"
        android:gravity="center"
        android:textSize="18sp"
        android:textColor="@android:color/holo_red_dark"
        android:textStyle="bold"/>

    <Button
        android:id="@+id/btnGotIt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Got it!"
        android:textAllCaps="false"
        android:backgroundTint="@android:color/holo_blue_light"
        android:textColor="@android:color/white"/>
</LinearLayout>
