package com.example.ticketapp;

/**
 * Copy this file to Secrets.java (same folder) and fill in your own values.
 * Secrets.java is listed in .gitignore and must never be committed.
 */
public final class Secrets {
    private Secrets() {}

    // Ethereum Sepolia RPC endpoint (QuickNode, Infura, Alchemy, etc.)
    public static final String SEPOLIA_RPC_URL = "https://YOUR-SEPOLIA-RPC-ENDPOINT";

    // Private key of the TESTNET wallet that owns the contract. Never use a wallet holding real funds.
    public static final String MINTER_PRIVATE_KEY = "YOUR_TESTNET_PRIVATE_KEY";
}
